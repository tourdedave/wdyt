{
  "manifest_version": 3,
  "name": "WDIT",
  "version": "0.1.0",
  "key": "",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1:3876/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
