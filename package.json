{
  "name": "wdyt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wdyt": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-extension-build.mjs && node scripts/copy-extension-manifest.mjs && node scripts/copy-cli-assets.mjs",
    "dev:server": "node --watch dist/server/index.js",
    "start:server": "node dist/server/index.js",
    "flows": "node dist/cli/index.js flows",
    "test:integration": "npm run build && node --test test/integration/control-flow.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
